# Root Environment Variables for Docker Compose

# MongoDB Settings
MONGODB_URI=mongodb://mongodb:27017/iris

# Backend Settings
PORT=3009

# Twilio Credentials (Required for DMS & Backend Alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1234567890
TWILIO_FLOW_SID=your_twilio_flow_sid

# Frontend Variables (Used if building frontend)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
